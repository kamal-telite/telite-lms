# =============================================================================
# Telite LMS - Example Environment
# Copy to .env for local Docker development and replace placeholder secrets.
# =============================================================================

# App environment (see docs/adr/004-schema-authority.md)
ENVIRONMENT=development
# PostgreSQL always uses Alembic; set false only for SQLite CI/local bootstrap.
TELITE_USE_ALEMBIC=true
LOG_LEVEL=INFO
LOG_FORMAT=text

# Host and internal ports
FRONTEND_PORT=3000
BACKEND_PORT=8001
BACKEND_INTERNAL_PORT=8001
BACKEND_SERVICE_HOST=backend
MOODLE_PORT=8082
POSTGRES_PORT=55432
REDIS_PORT=6379

# Frontend dev proxy
VITE_FRONTEND_DEV_PORT=3000
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8001
VITE_BACKEND_URL=http://127.0.0.1:8001
VITE_API_BASE_URL=http://localhost:8001

# PostgreSQL bootstrap database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# Telite application database
TELITE_DB_BACKEND=postgres
TELITE_POSTGRES_DB=telite_backend
TELITE_POSTGRES_USER=telite_app
TELITE_POSTGRES_PASSWORD=change-me-telite-password
TELITE_RUNTIME_POSTGRES_USER=telite_app
TELITE_RUNTIME_POSTGRES_PASSWORD=change-me-telite-password
TELITE_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:change-me-postgres-password@postgres:5432/telite_backend

# Optional local backend database values for non-Docker runs
TELITE_DATABASE_URL=
TELITE_POSTGRES_HOST=localhost
TELITE_POSTGRES_PORT=5432
TELITE_SQLITE_SOURCE_PATH=

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=change-me-redis-password
REDIS_ENABLED=true
REDIS_DB=0
REDIS_DB_CELERY=1

# Auth/security
TELITE_AUTH_SECRET=replace-with-64-plus-random-hex-or-base64
TELITE_PASSWORD_SALT=replace-with-random-password-salt
TELITE_ADMIN_PASSWORD=
TELITE_DEFAULT_LEARNER_PASSWORD=
TELITE_SEED_ADMIN_PASSWORD=
TELITE_SEED_LEARNER_PASSWORD=
TELITE_ACCESS_TOKEN_HOURS=8
TELITE_REFRESH_TOKEN_DAYS=14
JWT_ALGORITHM=HS256
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# App URLs / CORS
TELITE_APP_URL=http://localhost:3000
TELITE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# SMTP / email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Telite LMS

# Moodle integration
MOODLE_MODE=auto
MOODLE_URL=http://localhost:8082
MOODLE_INTERNAL_URL=http://moodle
MOODLE_WWWROOT=http://localhost:8082
MOODLE_TOKEN=replace-with-moodle-token
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodleuser
MOODLE_DB_PASSWORD=change-me-moodle-password
MOODLE_TEACHER_ROLE_ID=3
MOODLE_STUDENT_ROLE_ID=5
MOODLE_PARENT_CATEGORY_ID=15
MOODLE_PARENT_CATEGORY_NAME=Telite Systems

# Media storage / Cloudflare R2-compatible object storage
R2_ENABLED=false
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=telite-media-bucket
STORAGE_BUCKET=telite-media-dev
STORAGE_ENDPOINT=https://s3.telite.local

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Endpoint rate limits
TELITE_LOGIN_FAILURE_LIMIT=5
TELITE_LOGIN_FAILURE_WINDOW_SECONDS=300
TELITE_FORGOT_PASSWORD_LIMIT=3
TELITE_FORGOT_PASSWORD_WINDOW_SECONDS=900
TELITE_RESET_PASSWORD_LIMIT=5
TELITE_RESET_PASSWORD_WINDOW_SECONDS=900
TELITE_PLATFORM_ADMIN_INVITE_LIMIT=5
TELITE_PLATFORM_ADMIN_INVITE_WINDOW_SECONDS=600
TELITE_PLATFORM_PASSWORD_RESET_LIMIT=5
TELITE_PLATFORM_PASSWORD_RESET_WINDOW_SECONDS=900
TELITE_PLATFORM_MOODLE_SYNC_ORG_LIMIT=3
TELITE_PLATFORM_MOODLE_SYNC_ORG_WINDOW_SECONDS=600
TELITE_PLATFORM_MOODLE_SYNC_ALL_LIMIT=2
TELITE_PLATFORM_MOODLE_SYNC_ALL_WINDOW_SECONDS=600
TELITE_PLATFORM_ANALYTICS_ALERT_LIMIT=10
TELITE_PLATFORM_ANALYTICS_ALERT_WINDOW_SECONDS=600
TELITE_ENROL_BATCH_APPROVE_LIMIT=5
TELITE_ENROL_BATCH_APPROVE_WINDOW_SECONDS=600

# Optional verification scripts
TELITE_LIVE_API_BASE_URL=http://127.0.0.1:8001
TELITE_CONTRACT_BASE_URL=http://localhost:8001
TELITE_LOAD_TEST_BASE_URL=http://localhost:8001
