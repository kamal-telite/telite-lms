# =============================================================================
# Telite LMS - Docker Compose Environment Variables
# Copy of .env at the repository root for Docker Compose.
# =============================================================================

# -----------------------------------------------------------------------------
# App ports
# -----------------------------------------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3000
MOODLE_PORT=8082
POSTGRES_PORT=55432

# -----------------------------------------------------------------------------
# PostgreSQL / Docker database
# -----------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123


TELITE_MIGRATION_DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/telite_backend
# -----------------------------------------------------------------------------
# Backend database selection
# -----------------------------------------------------------------------------
TELITE_DB_BACKEND=postgres

# Backend PostgreSQL settings used by the backend container
TELITE_POSTGRES_DB=telite_backend
TELITE_POSTGRES_USER=postgres
TELITE_POSTGRES_PASSWORD=postgres123

# Redis and asynchronous Moodle sync
REDIS_ENABLED=true
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# -----------------------------------------------------------------------------
# Backend auth / security
# -----------------------------------------------------------------------------
TELITE_AUTH_SECRET=
TELITE_PASSWORD_SALT=
TELITE_ACCESS_TOKEN_HOURS=8
TELITE_REFRESH_TOKEN_DAYS=14

# -----------------------------------------------------------------------------
# Frontend / backend URL settings
# -----------------------------------------------------------------------------
TELITE_APP_URL=http://localhost:3000
TELITE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# SMTP / email delivery
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lokeshthakunna@gmail.com
SMTP_PASSWORD=sxfj qewn deri sara
FROM_NAME=Telite LMS

# -----------------------------------------------------------------------------
# Moodle integration
# -----------------------------------------------------------------------------
MOODLE_MODE=mock
MOODLE_URL=http://localhost:8082
MOODLE_WWWROOT=http://localhost:8082
MOODLE_TOKEN=
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodleuser
MOODLE_DB_PASSWORD=moodle123
MOODLE_TEACHER_ROLE_ID=3
MOODLE_STUDENT_ROLE_ID=5
MOODLE_PARENT_CATEGORY_ID=
MOODLE_PARENT_CATEGORY_NAME=Telite Systems



TELITE_UPLOAD_ROOT=/app/uploads
TELITE_UPLOADS_VOLUME=telite-lms_uploads
TELITE_ASSIGNMENT_UPLOAD_DIR=
